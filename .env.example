# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you: it asks which
#  integrations you want, collects each key, and writes .env.local.
#
#  Every key here is OPTIONAL. With none set, PriceNova runs in DEMO MODE with
#  realistic sample products, competitor prices and price history so you can see
#  it immediately.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (database & auth) ───────────────────────────────────────────────
# Your products, competitors and price history. https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Price data (scraping provider) ───────────────────────────────────────────
# Scrapes competitor product pages for live price, stock and shipping.
# Any scraping/price-data provider works (Scrapingdog, ScraperAPI, Bright Data…).
# https://www.scrapingdog.com/documentation
SCRAPINGDOG_API_KEY=

# ── Shopify (catalog + write-back) ───────────────────────────────────────────
# Pull your catalog and write repriced prices back. WooCommerce works the same.
# https://shopify.dev/docs/api/admin
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=

# ── Slack (alerts) ───────────────────────────────────────────────────────────
# Post price-drop and lost-position alerts to a channel (email alerts work without it).
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
